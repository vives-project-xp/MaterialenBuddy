DATABASE_URL=mysql+pymysql://root:password@localhost/materialenbuddy

# Authentik (OIDC) - vul in na het aanmaken van een toepassing in de Authentik admin
AUTHENTIK_ISSUER=http://localhost:9000
AUTHENTIK_CLIENT_ID=materialenbuddy
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:8000/auth/callback

# Sessie - gebruik een lange willekeurige string
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=28800
