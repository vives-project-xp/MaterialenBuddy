<?xml version="1.0"?>
<!-- Sala de 8x8 m con un tabique con puerta y varios obstaculos, para probar SLAM + teleop.
     Robot en el origen. gz-sim (Harmonic). El sistema Sensors (ogre2) es necesario para el gpu_lidar. -->
<sdf version="1.9">
  <world name="room">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_n">
      <static>true</static>
      <pose>0 4 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.1 0.1 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8.1 0.1 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_s">
      <static>true</static>
      <pose>0 -4 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.1 0.1 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8.1 0.1 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_e">
      <static>true</static>
      <pose>4 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 8.1 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 8.1 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_w">
      <static>true</static>
      <pose>-4 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 8.1 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 8.1 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="divider_a">
      <static>true</static>
      <pose>-1.75 1.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.5 0.1 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4.5 0.1 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="divider_b">
      <static>true</static>
      <pose>2.85 1.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.3 0.1 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.3 0.1 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="box_1">
      <static>true</static>
      <pose>-2.0 -2.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.8 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="box_2">
      <static>true</static>
      <pose>2.0 -2.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 1.2 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.6 1.2 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pillar_1">
      <static>true</static>
      <pose>2.5 2.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.8 0.4 0.3 1</ambient><diffuse>0.8 0.4 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="box_3">
      <static>true</static>
      <pose>-2.5 2.8 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 0.5 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.5 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
