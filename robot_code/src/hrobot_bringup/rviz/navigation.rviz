# Configuración mínima de RViz para navegar con Nav2. '/<robot_namespace>' se sustituye por '/r2' (o por nada).
# Escrita a mano y sin probar: si algo no se ve, ajústalo en RViz y guarda con File > Save Config.
# Herramientas: "2D Pose Estimate" (pose inicial de AMCL) y "2D Goal Pose" (meta de navegación).
Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/Map
      Name: Mapa
      Enabled: true
      Alpha: 0.7
      Topic:
        Value: /<robot_namespace>/map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: Costmap global
      Enabled: true
      Alpha: 0.4
      Color Scheme: costmap
      Topic:
        Value: /<robot_namespace>/global_costmap/costmap
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: Costmap local
      Enabled: true
      Alpha: 0.6
      Color Scheme: costmap
      Topic:
        Value: /<robot_namespace>/local_costmap/costmap
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: Ruta global
      Enabled: true
      Color: 0; 200; 0
      Topic:
        Value: /<robot_namespace>/plan
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Size (m): 0.03
      Style: Flat Squares
      Color: 255; 0; 0
      Topic:
        Value: /<robot_namespace>/scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
    - Class: nav2_rviz_plugins/ParticleCloud
      Name: Partículas AMCL
      Enabled: true
      Topic:
        Value: /<robot_namespace>/particle_cloud
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /<robot_namespace>/robot_description
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /<robot_namespace>/initialpose
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /<robot_namespace>/goal_pose
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 60
      Target Frame: <Fixed Frame>
