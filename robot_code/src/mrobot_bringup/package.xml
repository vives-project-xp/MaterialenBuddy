<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mrobot_bringup</name>
  <version>0.1.0</version>
  <description>Real-robot bringup: 2D LiDAR, robot description, mapping, navigation and helper nodes (scan_resampler, odom_relay).</description>
  <maintainer email="your_email@example.com">Brandon</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>irobot_create_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!--
    LD19 driver: `ldlidar_stl_ros2` (LDRobot, MIT). It is NOT a rosdep key, but it is included
    in this repository (src/ldlidar_stl_ros2/, see its VENDORED.md), so colcon builds it on its own.
  -->
  <exec_depend>ldlidar_stl_ros2</exec_depend>
  <!--
    RPLIDAR C1 driver: `sllidar_ros2` (Slamtec, BSD). It is NOT a rosdep key, but it is included
    in this repository (src/sllidar_ros2/, see its VENDORED.md), so colcon builds it on its own.
  -->
  <exec_depend>sllidar_ros2</exec_depend>

  <!-- Mapping -->
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <!-- Navigation (AMCL + Nav2) -->
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_smoother</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>nav2_rviz_plugins</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
