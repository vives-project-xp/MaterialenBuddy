<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>irobot_create_description</name>
  <version>0.0.0</version>
  <description>Robot description (URDF/XACRO) of the Create 3 with the LD19 LiDAR</description>
  <maintainer email="your_email@example.com">Brandon</maintainer>
  <!-- BSD-3-Clause: official iRobot URDF/XACRO and meshes (see LICENSE and ATTRIBUTION.md).
       Apache-2.0: own files (create3_lidar, lidar_*, launch and rviz). -->
  <license>BSD-3-Clause</license>
  <license>Apache-2.0</license>

  <!-- Tool used to build the package (ament_cmake) -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>urdf</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
