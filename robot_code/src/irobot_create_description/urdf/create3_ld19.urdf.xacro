<?xml version="1.0"?>
<!-- Create 3 + LD19 LiDAR mounted at the center, on top of the robot lid. -->
<robot name="create3_ld19" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Official robot (declares the "gazebo" and "namespace" args and the body properties) -->
  <xacro:include filename="$(find irobot_create_description)/urdf/create3.urdf.xacro"/>
  <xacro:include filename="$(find irobot_create_description)/urdf/sensors/lidar_ld19.urdf.xacro"/>

  <!-- LD19 rotation relative to the robot front (rad). 0 = the sensor's 0° points forward. -->
  <xacro:arg name="laser_yaw" default="0.0"/>

  <!-- Create 3 lid in the base_link frame (top of the collision cylinder) -->
  <xacro:property name="create3_top_z"
                  value="${body_z_offset + body_collision_z_offset + base_link_z_offset + body_length / 2}"/>

  <!-- The laser frame is on the scan plane, ld19_scan_z_from_base above the
       LD19 base, which rests on the lid. Centered: x = y = 0. -->
  <xacro:lidar_ld19 name="laser" parent="base_link" gazebo="$(arg gazebo)" visualize="$(arg visualize_rays)">
    <origin xyz="0 0 ${create3_top_z + ld19_scan_z_from_base}" rpy="0 0 $(arg laser_yaw)"/>
  </xacro:lidar_ld19>

</robot>
