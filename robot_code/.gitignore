# Only src/, scripts/, maps/ (the folder), README.md and this .gitignore are versioned; everything else stays local
/*
!/src/
!/scripts/
!/maps/
!/README.md
!/.gitignore

# colcon / ROS 2
build/
install/
log/

# IDE / OS
.vscode/
.idea/
.DS_Store

# Secrets
.env
*.pem
.cache/
*.swp
compile_commands.json
__pycache__/
*.pyc

# Saved maps (only the folder is versioned)
maps/*
!maps/.gitkeep

# Local context notes
CONTEXTO.md
