# Solo se versiona src/, scripts/, maps/ (carpeta), README.md y este .gitignore; todo lo demás queda local
/*
!/src/
!/scripts/
!/maps/
!/README.md
!/.gitignore

# colcon / ROS 2
build/
install/
log/

# IDE / OS
.vscode/
.idea/
.DS_Store

# Secretos
.env
*.pem
.cache/
*.swp
compile_commands.json
__pycache__/
*.pyc

# Mapas guardados (solo se versiona la carpeta)
maps/*
!maps/.gitkeep

# Notas de contexto locales
CONTEXTO.md
